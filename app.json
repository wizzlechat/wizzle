{
  "expo": {
    "name": "wizzle",
    "slug": "wizzle",
    "version": "1.0.0",
    "scheme": "wizzle",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.wizzleai.ios",
      "buildNumber": "1.0.14",
      "appleTeamId": "L96WZ5P5WD",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "allowBackup": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "wizzle scans the pairing code shown by your bridge."
        }
      ],
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "wizzle attaches the photos you pick to a message for your agent.",
          "cameraPermission": "wizzle scans the pairing code shown by your bridge."
        }
      ],
      "expo-sharing",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "wizzle listens while you dictate a message.",
          "speechRecognitionPermission": "wizzle turns what you dictate into message text on this iPhone. The audio never leaves it."
        }
      ]
    ]
  }
}
